# GitHub Codespaces Configuration
# This file documents required environment variables for the frontend

# VITE_CODESPACE_NAME: Your GitHub Codespace name
# This is used to construct the API base URL for the backend
# Format: https://<VITE_CODESPACE_NAME>-8000.app.github.dev/api
# 
# To find your Codespace name, check your browser URL or GitHub settings
# Example: VITE_CODESPACE_NAME=silver-funicular-xxpqvvxv
#
# If left unset, the app will use http://localhost:8000/api for local development
VITE_CODESPACE_NAME=your-codespace-name-here
